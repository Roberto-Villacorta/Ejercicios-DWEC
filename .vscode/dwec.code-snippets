{
    "DWEC: Validar Texto": {
        "scope": "javascript,html",
        "prefix": "val-texto",
        "body": [
            "function validaTexto(${1:valor}, ${2:min = 3}, ${3:max = 40}) {",
            "\tif (!${1:valor} || typeof ${1:valor} !== \"string\") return false;",
            "\t${1:valor} = ${1:valor}.trim();",
            "\tif (${1:valor}.length < ${2:min} || ${1:valor}.length > ${3:max}) return false;",
            "",
            "\tvar letrasPermitidas = \"abcdefghijklmnñopqrstuvwxyzáéíóúüABCDEFGHIJKLMNÑOPQRSTUVWXYZÁÉÍÓÚÜ \";",
            "\tfor (var i = 0; i < ${1:valor}.length; i++) {",
            "\t\tif (letrasPermitidas.indexOf(${1:valor}.charAt(i)) === -1) {",
            "\t\t\treturn false;",
            "\t\t}",
            "\t}",
            "\treturn true;",
            "}"
        ],
        "description": "Valida que el texto no esté vacío, cumpla rango de longitud y solo contenga letras (incluye tildes, ñ y espacios)."
    },

    "DWEC: Validar Número Entero sin Regex (0-9)": {
        "scope": "javascript,html",
        "prefix": "val-enteros",
        "body": [
            "function validaNumero(${1:valor}) {",
            "\tif (${1:valor} === null || ${1:valor} === undefined) return false;",
            "\tvar str = ${1:valor}.toString().trim();",
            "\tif (str === \"\") return false;",
            "",
            "\tvar nums = \"0123456789\";",
            "\tfor (var i = 0; i < str.length; i++) {",
            "\t\tif (nums.indexOf(str.charAt(i)) === -1) {",
            "\t\t\treturn false;",
            "\t\t}",
            "\t}",
            "\treturn true;",
            "}"
        ],
        "description": "Valida que el valor contenga solo caracteres numéricos del 0 al 9 usando indexOf (estilo examen sin regex)."
    },

    "DWEC: Validar Número": {
        "scope": "javascript,html",
        "prefix": "val-numero",
        "body": [
            "function validaNumero(${1:valor}, ${2:min = -Infinity}, ${3:max = Infinity}) {",
            "\tif (${1:valor} === null || ${1:valor} === undefined) return false;",
            "\tvar str = ${1:valor}.toString().trim();",
            "\tif (str === \"\") return false;",
            "",
            "\tvar num = Number(str);",
            "\tif (Number.isNaN(num)) return false;",
            "\tif (num < ${2:min} || num > ${3:max}) return false;",
            "",
            "\treturn true;",
            "}"
        ],
        "description": "Valida que el valor sea un número real/entero válido dentro de un rango opcional."
    },

    "DWEC: Validar Fecha sin Objeto Date (dd/mm/yyyy)": {
        "scope": "javascript,html",
        "prefix": "val-fecha-noobj",
        "body": [
            "function validaFechaSinObjeto(${1:fechaTexto}, ${2:anioMin = 1900}, ${3:anioMax = 2100}) {",
            "\tif (!${1:fechaTexto} || typeof ${1:fechaTexto} !== \"string\") return false;",
            "\t${1:fechaTexto} = ${1:fechaTexto}.trim();",
            "",
            "\tvar partes = ${1:fechaTexto}.split(\"/\");",
            "\tif (partes.length !== 3) return false;",
            "",
            "\tvar diaStr = partes[0].trim();",
            "\tvar mesStr = partes[1].trim();",
            "\tvar anioStr = partes[2].trim();",
            "",
            "\tif (diaStr.length !== 2 || mesStr.length !== 2 || anioStr.length !== 4) return false;",
            "",
            "\tvar esSoloDigitos = function(cadena) {",
            "\t\tfor (var i = 0; i < cadena.length; i++) {",
            "\t\t\tif (cadena.charAt(i) < '0' || cadena.charAt(i) > '9') return false;",
            "\t\t}",
            "\t\treturn true;",
            "\t};",
            "\tif (!esSoloDigitos(diaStr) || !esSoloDigitos(mesStr) || !esSoloDigitos(anioStr)) return false;",
            "",
            "\tvar dia = parseInt(diaStr, 10);",
            "\tvar mes = parseInt(mesStr, 10);",
            "\tvar anio = parseInt(anioStr, 10);",
            "",
            "\tif (anio < ${2:anioMin} || anio > ${3:anioMax}) return false;",
            "\tif (mes < 1 || mes > 12) return false;",
            "",
            "\tvar diasPorMes = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];",
            "\tvar esBisiesto = (anio % 4 === 0 && anio % 100 !== 0) || (anio % 400 === 0);",
            "\tif (esBisiesto) {",
            "\t\tdiasPorMes[1] = 29;",
            "\t}",
            "",
            "\tif (dia < 1 || dia > diasPorMes[mes - 1]) return false;",
            "",
            "\treturn true;",
            "}"
        ],
        "description": "Valida fecha dd/mm/yyyy sin usar objeto Date (comprueba formato, dígitos, meses, días y años bisiestos)."
    },

    "DWEC: Validar DNI": {
        "scope": "javascript,html",
        "prefix": "val-dni",
        "body": [
            "function validaDNI(${1:dni}) {",
            "\tif (!${1:dni} || typeof ${1:dni} !== \"string\") return false;",
            "\t${1:dni} = ${1:dni}.trim().toUpperCase();",
            "\tif (${1:dni}.length !== 9) return false;",
            "",
            "\tvar numeroStr = ${1:dni}.substring(0, 8);",
            "\tvar letra = ${1:dni}.charAt(8);",
            "",
            "\tfor (var i = 0; i < 8; i++) {",
            "\t\tif (numeroStr.charAt(i) < '0' || numeroStr.charAt(i) > '9') return false;",
            "\t}",
            "",
            "\tvar letrasValidas = \"TRWAGMYFPDXBNJZSQVHLCKE\";",
            "\tvar numero = parseInt(numeroStr, 10);",
            "\tvar letraCalculada = letrasValidas.charAt(numero % 23);",
            "",
            "\treturn letra === letraCalculada;",
            "}"
        ],
        "description": "Valida un DNI español (8 dígitos + letra de control oficial)."
    },

    "DWEC: Función Validadora Centralizada (Agrupa Errores)": {
        "scope": "javascript,html",
        "prefix": "dwec-val-objeto",
        "body": [
            "function validacion(${1:obj}) {",
            "\tvar textoError = \"\";",
            "\tif (!validaTexto(${1:obj}.${2:titulo})) {",
            "\t\ttextoError += \"${3:Título inválido}<br>\";",
            "\t}",
            "\tif (!validaNumero(${1:obj}.${4:visitas})) {",
            "\t\ttextoError += \"${5:Las visitas deben ser un número}<br>\";",
            "\t}",
            "\tif (!validaFechaSinObjeto(${1:obj}.${6:fechaCreacion})) {",
            "\t\ttextoError += \"${7:La fecha debe ser correcta (dd/mm/aaaa)}<br>\";",
            "\t}",
            "\treturn textoError;",
            "}"
        ],
        "description": "Función que agrupa las validaciones de los campos y acumula los mensajes de error en formato HTML."
    },

    "DWEC: Clase ES6 (Constructor, Getters y Setters)": {
        "scope": "javascript",
        "prefix": "dwec-clase",
        "body": [
            "class ${1:Web} {",
            "\tconstructor(${2:titulo}, ${3:fechaCreacion}, ${4:visitas}) {",
            "\t\tthis._${2:titulo} = ${2:titulo};",
            "\t\tthis._${3:fechaCreacion} = ${3:fechaCreacion};",
            "\t\tthis._${4:visitas} = ${4:visitas};",
            "\t}",
            "",
            "\tget ${2:titulo}() { return this._${2:titulo}; }",
            "\tset ${2:titulo}(v) { this._${2:titulo} = v; }",
            "",
            "\tget ${3:fechaCreacion}() { return this._${3:fechaCreacion}; }",
            "\tset ${3:fechaCreacion}(v) { this._${3:fechaCreacion} = v; }",
            "",
            "\tget ${4:visitas}() { return this._${4:visitas}; }",
            "\tset ${4:visitas}(v) { this._${4:visitas} = v; }",
            "",
            "\t${5:// métodos propios}",
            "}"
        ],
        "description": "Plantilla de clase ES6 con constructor, propiedades privadas por convención (_prop) y sus getters/setters."
    },

    "DWEC: Calcular Días de Antigüedad / Diferencia (dd/mm/aaaa)": {
        "scope": "javascript",
        "prefix": "dwec-dias",
        "body": [
            "${1:diasEnLaWeb}() {",
            "\tconst hoy = new Date();",
            "\tconst arrF = this.${2:fechaCreacion}.split(\"/\");",
            "\tconst fechaInicio = new Date(arrF[2], arrF[1] - 1, arrF[0]); // año, mes-1, día",
            "\tconst diferenciaMs = hoy.getTime() - fechaInicio.getTime();",
            "\treturn Math.floor(diferenciaMs / (1000 * 60 * 60 * 24)); // ms a días",
            "}"
        ],
        "description": "Calcula la diferencia exacta en días entre una fecha 'dd/mm/aaaa' y la fecha actual."
    },

    "DWEC: Mostrar Un Objeto en Ventana (Método Instancia)": {
        "scope": "javascript",
        "prefix": "dwec-mostrar-uno",
        "body": [
            "${1:mostrarWeb}() {",
            "\tlet tabla = \"<table border='1'><tr><th>${2:Título}</th><th>${3:Fecha de creación}</th><th>${4:Visitas}</th></tr>\";",
            "\ttabla += `<tr><td>\\${this.${5:titulo}}</td><td>\\${this.${6:fechaCreacion}}</td><td>\\${this.${7:visitas}}</td></tr>`;",
            "\ttabla += \"</table>\";",
            "",
            "\tconst miVentana = window.open(\"\", \"_blank\", \"width=500,height=400\");",
            "\tif (!miVentana) { alert(\"Permite las ventanas emergentes\"); return; }",
            "\tmiVentana.document.write(",
            "\t\t\"<!DOCTYPE html>\",",
            "\t\t\"<html lang='es'>\",",
            "\t\t\"<head>\",",
            "\t\t'<meta charset=\"UTF-8\">',",
            "\t\t'<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">',",
            "\t\t\"<title>${8:Document}</title>\",",
            "\t\t\"</head>\",",
            "\t\t\"<body>\",",
            "\t\ttabla,",
            "\t\t\"<button onclick='window.close()'>Volver a la página anterior</button>\",",
            "\t\t\"</body>\",",
            "\t\t\"</html>\"",
            "\t);",
            "\tmiVentana.document.close();",
            "}"
        ],
        "description": "Método de instancia que muestra un objeto en una ventana emergente mediante document.write con botón de cierre."
    },

    "DWEC: Mostrar Todos en Ventana (Método Estático)": {
        "scope": "javascript",
        "prefix": "dwec-mostrar-todos",
        "body": [
            "static ${1:mostrarWebs}(${2:webs}) {",
            "\tlet tabla = \"<table border='1'><tr><th>${3:Título}</th><th>${4:Fecha de creación}</th><th>${5:Visitas}</th></tr>\";",
            "\tfor (const item of ${2:webs}) {",
            "\t\ttabla += `<tr><td>\\${item.${6:titulo}}</td><td>\\${item.${7:fechaCreacion}}</td><td>\\${item.${8:visitas}}</td></tr>`;",
            "\t}",
            "\ttabla += \"</table>\";",
            "",
            "\tconst miVentana = window.open(\"\", \"_blank\", \"width=500,height=400\");",
            "\tif (!miVentana) { alert(\"Permite las ventanas emergentes\"); return; }",
            "\tmiVentana.document.write(",
            "\t\t\"<!DOCTYPE html>\",",
            "\t\t\"<html lang='es'>\",",
            "\t\t\"<head>\",",
            "\t\t'<meta charset=\"UTF-8\">',",
            "\t\t'<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">',",
            "\t\t\"<title>${9:Listado Completo}</title>\",",
            "\t\t\"</head>\",",
            "\t\t\"<body>\",",
            "\t\ttabla,",
            "\t\t\"<button onclick='window.close()'>Volver a la página anterior</button>\",",
            "\t\t\"</body>\",",
            "\t\t\"</html>\"",
            "\t);",
            "\tmiVentana.document.close();",
            "}"
        ],
        "description": "Método estático de clase que muestra toda la colección en una ventana emergente con tabla y botón de volver."
    },

    "DWEC: Navegación Unificada navega(direccion)": {
        "scope": "javascript,html",
        "prefix": "nav-navega",
        "body": [
            "var ${1:coleccion} = [];",
            "var ${2:thisNum} = 0;",
            "",
            "function navega(direccion) {",
            "\tif (${1:coleccion}.length === 0) {",
            "\t\t${2:thisNum} = 0;",
            "\t\t${3:muestraRegistro}();",
            "\t\treturn;",
            "\t}",
            "",
            "\tvar arrCt = ${1:coleccion}.length - 1;",
            "\tif (direccion === 2) {",
            "\t\t${2:thisNum} = 0; // Primera",
            "\t} else if (direccion === 3) {",
            "\t\t${2:thisNum} = arrCt; // Última",
            "\t} else {",
            "\t\t${2:thisNum} += direccion; // -1 (anterior) o 1 (siguiente)",
            "\t\tif (${2:thisNum} > arrCt) ${2:thisNum} = 0;",
            "\t\tif (${2:thisNum} < 0) ${2:thisNum} = arrCt;",
            "\t}",
            "\t${3:muestraRegistro}();",
            "}"
        ],
        "description": "Función navega(dir): 2=Primera, 3=Última, -1=Anterior, 1=Siguiente (con saltos circulares)."
    },

    "DWEC: Métodos de Navegación Modulares": {
        "scope": "javascript,html",
        "prefix": "nav-modulares",
        "body": [
            "var ${1:coleccion} = [];",
            "var ${2:indice} = 0;",
            "",
            "function primera() {",
            "\tif (${1:coleccion}.length === 0) return;",
            "\t${2:indice} = 0;",
            "\t${3:muestraRegistro}();",
            "}",
            "",
            "function anterior() {",
            "\tif (${1:coleccion}.length === 0) return;",
            "\tif (${2:indice} > 0) {",
            "\t\t${2:indice}--;",
            "\t} else {",
            "\t\t${2:indice} = ${1:coleccion}.length - 1; // Circular",
            "\t}",
            "\t${3:muestraRegistro}();",
            "}",
            "",
            "function siguiente() {",
            "\tif (${1:coleccion}.length === 0) return;",
            "\tif (${2:indice} < ${1:coleccion}.length - 1) {",
            "\t\t${2:indice}++;",
            "\t} else {",
            "\t\t${2:indice} = 0; // Circular",
            "\t}",
            "\t${3:muestraRegistro}();",
            "}",
            "",
            "function ultima() {",
            "\tif (${1:coleccion}.length === 0) return;",
            "\t${2:indice} = ${1:coleccion}.length - 1;",
            "\t${3:muestraRegistro}();",
            "}"
        ],
        "description": "Funciones independientes: primera(), anterior(), siguiente() y ultima()."
    },

    "DWEC: Muestra Registro en Formulario": {
        "scope": "javascript,html",
        "prefix": "dwec-muestra-registro",
        "body": [
            "function muestraRegistro() {",
            "\tif (${1:webs}.length === 0) return;",
            "\tdocument.getElementById(\"${2:miTitulo}\").value = ${1:webs}[${3:indice}].${4:titulo};",
            "\tdocument.getElementById(\"${5:miFecha}\").value = ${1:webs}[${3:indice}].${6:fechaCreacion};",
            "\tdocument.getElementById(\"${7:miVisitas}\").value = ${1:webs}[${3:indice}].${8:visitas};",
            "}"
        ],
        "description": "Carga los valores del objeto actual del array en los inputs correspondientes del formulario."
    },

    "DWEC: Bloquear Navegación por ID": {
        "scope": "javascript,html",
        "prefix": "dwec-bloquear-nav",
        "body": [
            "function bloquearNavegacion(deshabilitar) {",
            "\tdocument.getElementById(\"btnPrimera\").disabled = deshabilitar;",
            "\tdocument.getElementById(\"btnAnterior\").disabled = deshabilitar;",
            "\tdocument.getElementById(\"btnSiguiente\").disabled = deshabilitar;",
            "\tdocument.getElementById(\"btnUltima\").disabled = deshabilitar;",
            "}"
        ],
        "description": "Habilita o deshabilita los 4 botones de navegación por su ID."
    },

    "DWEC: Control de Botones de Navegación": {
        "scope": "javascript,html",
        "prefix": "nav-botones",
        "body": [
            "function actualizarBotonesNavegacion() {",
            "\tvar btnUno = document.getElementById(\"uno\");",
            "\tvar btnDos = document.getElementById(\"dos\");",
            "\tvar btnTres = document.getElementById(\"tres\");",
            "\tvar btnCuatro = document.getElementById(\"cuatro\");",
            "\tif (!btnUno) return;",
            "",
            "\tvar vacio = ${1:coleccion}.length === 0;",
            "\tbtnUno.disabled = vacio || ${2:thisNum} === 0;",
            "\tbtnDos.disabled = vacio || ${2:thisNum} === 0;",
            "\tbtnTres.disabled = vacio || ${2:thisNum} === ${1:coleccion}.length - 1;",
            "\tbtnCuatro.disabled = vacio || ${2:thisNum} === ${1:coleccion}.length - 1;",
            "}",
            "",
            "function bloquearNavegacion(bloquear) {",
            "\t[\"uno\", \"dos\", \"tres\", \"cuatro\"].forEach(function(id) {",
            "\t\tvar el = document.getElementById(id);",
            "\t\tif (el) el.disabled = bloquear;",
            "\t});",
            "}"
        ],
        "description": "Habilitar/deshabilitar botones de navegación según la posición o estado del formulario."
    },

    "DWEC: Estructura CRUD Examen (Botones, Alta, Baja, Modificación, Cancelar)": {
        "scope": "javascript,html",
        "prefix": "dwec-crud",
        "body": [
            "var accionAceptar = 0; // 1 = Alta, 2 = Baja, 3 = Modificación",
            "",
            "function botones(deshabilitarAcciones, visibilidadAceptarCancelar) {",
            "\tdocument.getElementById(\"btnAlta\").disabled = deshabilitarAcciones;",
            "\tdocument.getElementById(\"btnBaja\").disabled = deshabilitarAcciones;",
            "\tdocument.getElementById(\"btnMod\").disabled = deshabilitarAcciones;",
            "\tdocument.getElementById(\"btnAcep\").style.visibility = visibilidadAceptarCancelar;",
            "\tdocument.getElementById(\"btnCancel\").style.visibility = visibilidadAceptarCancelar;",
            "\tvar divErr = document.getElementById(\"miDivErr\");",
            "\tif (divErr) divErr.innerHTML = \"\";",
            "}",
            "",
            "function limpiarFormulario() {",
            "\tdocument.getElementById(\"${1:miTitulo}\").value = \"\";",
            "\tdocument.getElementById(\"${2:miFecha}\").value = \"\";",
            "\tdocument.getElementById(\"${3:miVisitas}\").value = \"\";",
            "}",
            "",
            "function alta() {",
            "\tbloquearNavegacion(true);",
            "\tbotones(true, \"visible\");",
            "\tlimpiarFormulario();",
            "\taccionAceptar = 1;",
            "}",
            "",
            "function baja() {",
            "\tif (${4:webs}.length === 0) {",
            "\t\talert(\"No hay registros para eliminar\");",
            "\t\treturn;",
            "\t}",
            "\tbotones(true, \"visible\");",
            "\taccionAceptar = 2;",
            "}",
            "",
            "function modificacion() {",
            "\tif (${4:webs}.length === 0) {",
            "\t\talert(\"No hay registros para modificar\");",
            "\t\treturn;",
            "\t}",
            "\tbotones(true, \"visible\");",
            "\taccionAceptar = 3;",
            "}",
            "",
            "function cancelar() {",
            "\tbloquearNavegacion(false);",
            "\tbotones(false, \"hidden\");",
            "\taccionAceptar = 0;",
            "\t${5:muestraRegistro}();",
            "}"
        ],
        "description": "Estructura de gestión de estados y botones para Alta, Baja, Modificación y Cancelar."
    },

    "DWEC: Función Aceptar con Switch y Validación Completa": {
        "scope": "javascript,html",
        "prefix": "dwec-aceptar",
        "body": [
            "function aceptar() {",
            "\tswitch (accionAceptar) {",
            "\t\tcase 1: // ALTA",
            "\t\t\tvar nuevo = new ${1:Web}(",
            "\t\t\t\tdocument.getElementById(\"${2:miTitulo}\").value,",
            "\t\t\t\tdocument.getElementById(\"${3:miFecha}\").value,",
            "\t\t\t\tparseInt(document.getElementById(\"${4:miVisitas}\").value, 10)",
            "\t\t\t);",
            "\t\t\tif (validacion(nuevo) === \"\") {",
            "\t\t\t\t${5:webs}.push(nuevo);",
            "\t\t\t\tcancelar();",
            "\t\t\t} else {",
            "\t\t\t\tdocument.getElementById(\"miDivErr\").innerHTML = validacion(nuevo);",
            "\t\t\t}",
            "\t\t\tbreak;",
            "",
            "\t\tcase 2: // BAJA",
            "\t\t\tif (confirm(\"¿Seguro que desea eliminar este registro?\")) {",
            "\t\t\t\t${5:webs}.splice(${6:indice}, 1);",
            "\t\t\t\tif (${6:indice} >= ${5:webs}.length) ${6:indice} = ${5:webs}.length - 1;",
            "\t\t\t\tcancelar();",
            "\t\t\t}",
            "\t\t\tbreak;",
            "",
            "\t\tcase 3: // MODIFICACIÓN",
            "\t\t\tvar modificado = new ${1:Web}(",
            "\t\t\t\tdocument.getElementById(\"${2:miTitulo}\").value,",
            "\t\t\t\tdocument.getElementById(\"${3:miFecha}\").value,",
            "\t\t\t\tparseInt(document.getElementById(\"${4:miVisitas}\").value, 10)",
            "\t\t\t);",
            "\t\t\tif (validacion(modificado) === \"\") {",
            "\t\t\t\t${5:webs}[${6:indice}] = modificado;",
            "\t\t\t\tcancelar();",
            "\t\t\t} else {",
            "\t\t\t\tdocument.getElementById(\"miDivErr\").innerHTML = validacion(modificado);",
            "\t\t\t}",
            "\t\t\tbreak;",
            "\t}",
            "}"
        ],
        "description": "Función aceptar() completa para Alta, Baja y Modificación con creación de objeto y comprobación de errores."
    },

    "DWEC: Listado en Ventana Emergente": {
        "scope": "javascript,html",
        "prefix": "dwec-listado",
        "body": [
            "function listadoVentana() {",
            "\tif (${1:coleccion}.length === 0) {",
            "\t\talert(\"No hay datos para mostrar\");",
            "\t\treturn;",
            "\t}",
            "",
            "\tvar ventana = window.open(\"\", \"listado\", \"width=600,height=500,scrollbars=yes\");",
            "\tif (!ventana) {",
            "\t\talert(\"Por favor, permite ventanas emergentes\");",
            "\t\treturn;",
            "\t}",
            "",
            "\tvar html = \"<!DOCTYPE html><html lang='es'><head><meta charset='UTF-8'><title>Listado</title>\";",
            "\thtml += \"<style>table{border-collapse:collapse;margin:auto;width:90%;} th,td{border:1px solid #333;padding:8px;text-align:center;} th{background:#eee;}</style></head><body>\";",
